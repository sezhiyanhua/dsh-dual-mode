{
  "name": "dsh-dual-mode",
  "version": "0.2.0",
  "description": "DeepSeek Dual Mode: a native Harness/Chat switcher that drives the real chat.deepseek.com web UI in a persistent browser profile, extracts instructions for Harness sessions and brings execution results back to the web chat.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-chat",
    "dual-mode",
    "plugin-market"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezhiyanhua/dsh-dual-mode.git"
  },
  "homepage": "https://github.com/sezhiyanhua/dsh-dual-mode",
  "bugs": {
    "url": "https://github.com/sezhiyanhua/dsh-dual-mode/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
